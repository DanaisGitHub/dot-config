# Machine-specific overrides and secrets belong outside this repository.
*.local
*.local.*
secrets/

# Editor and operating-system generated files.
*.swp
*.swo
*~
.DS_Store

# OpenCode dependencies and dated configuration backups are reproducible or stale.
opencode/node_modules/
opencode/opencode.json.bak-*
opencode/.env
opencode/.env.*

# V2 service settings are machine-local and can contain server credentials.
opencode/service.json
opencode/service.jsonc
